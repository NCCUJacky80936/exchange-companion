{
  "name": "exchange-companion",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup-exchange.mjs",
    "doctor": "node scripts/doctor.mjs",
    "validate:profile": "node scripts/validate-profile.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "security:check": "npm run privacy:check && node scripts/security-check.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "deploy:preflight": "node scripts/assert-deploy-route.mjs && npx wrangler whoami",
    "deploy:cloudflare": "node scripts/assert-deploy-route.mjs && npm run check && npx wrangler deploy --config dist/server/wrangler.json",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:production": "npm run build && node scripts/verify-cloud-build.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "test:cloud": "node tests/cloud-smoke.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run validate:profile && npm run validate:skills && npm run security:check && npm run lint && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.120.0"
  },
  "type": "module"
}
